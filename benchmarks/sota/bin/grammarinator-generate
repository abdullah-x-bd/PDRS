#!/usr/bin/env python3
from __future__ import annotations

from pathlib import Path
import subprocess
import sys
import tempfile


def main() -> int:
    args = list(sys.argv[1:])
    if "--stdout" not in args:
        completed = subprocess.run([sys.executable, "-m", "grammarinator.generate", *args])
        return completed.returncode

    args.remove("--stdout")
    # Near-exhaustive duplicate suppression can require more than the CLI default
    # number of retries. This changes only the retry ceiling, not generation weights.
    for option in ("--unique-attempts",):
        if option in args:
            index = args.index(option)
            args[index + 1] = str(max(int(args[index + 1]), 100_000))

    with tempfile.TemporaryDirectory(prefix="pdrs-grammarinator-") as directory:
        pattern = str(Path(directory) / "case_%06d.txt")
        completed = subprocess.run(
            [sys.executable, "-m", "grammarinator.generate", *args, "-o", pattern],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if completed.returncode != 0:
            sys.stderr.write(completed.stderr)
            return completed.returncode
        paths = sorted(Path(directory).glob("case_*.txt"))
        for path in paths:
            text = path.read_text(encoding="utf-8")
            sys.stdout.write(text)
            if text and not text.endswith("\n"):
                sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
