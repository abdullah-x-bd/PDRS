{
  "name": "tool-calling-actions",
  "version": "1",
  "root": "tool",
  "nodes": {
    "tool": {
      "type": "choice",
      "field": "tool",
      "branches": [
        {"value": "search", "target": "search_scope"},
        {"value": "calendar", "target": "calendar_action"},
        {"value": "email", "target": "email_action"}
      ]
    },
    "search_scope": {
      "type": "choice", "field": "scope",
      "branches": [
        {"value": "web", "target": "search_depth"},
        {"value": "files", "target": "search_depth"}
      ]
    },
    "search_depth": {"type": "range", "field": "depth", "start": 1, "stop": 5, "target": "end"},
    "calendar_action": {
      "type": "choice", "field": "action",
      "branches": [
        {"value": "read", "target": "calendar_window"},
        {"value": "create", "target": "calendar_window"},
        {"value": "update", "target": "calendar_window"}
      ]
    },
    "calendar_window": {"type": "range", "field": "window", "start": 0, "stop": 6, "target": "end"},
    "email_action": {
      "type": "choice", "field": "action",
      "branches": [
        {"value": "read", "target": "mailbox"},
        {"value": "draft", "target": "mailbox"},
        {"value": "send", "target": "mailbox"},
        {"value": "archive", "target": "mailbox"}
      ]
    },
    "mailbox": {
      "type": "choice", "field": "mailbox",
      "branches": [
        {"value": "primary", "target": "end"},
        {"value": "shared", "target": "end"}
      ]
    },
    "end": {"type": "terminal"}
  }
}
