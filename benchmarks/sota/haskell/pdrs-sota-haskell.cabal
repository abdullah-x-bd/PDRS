cabal-version: 2.4
name: pdrs-sota-haskell
version: 0.1.0.0
build-type: Simple

executable sota-haskell
  main-is: Main.hs
  hs-source-dirs: .
  default-language: Haskell2010
  ghc-options: -O2 -Wall
  build-depends:
      base >=4.14 && <5
    , containers
    , directory
    , filepath
    , QuickCheck ==2.18.0.0
    , smallcheck ==1.2.1.1
    , testing-feat ==1.1.1.1
