from __future__ import annotations

from bisect import bisect_right
from dataclasses import dataclass
from datetime import date, datetime
from decimal import Decimal, InvalidOperation
import hashlib
import json
import math
import random
import unicodedata
from typing import Any, Iterable, Iterator, Mapping, Sequence

Token = str | int


class SchemaError(ValueError):
    pass


@dataclass(frozen=True)
class Limits:
    max_nodes: int = 100_000
    max_depth: int = 10_000
    max_range_width: int = 10**12
    max_domain_bits: int = 1_000_000


@dataclass(frozen=True)
class Terminal:
    name: str


@dataclass(frozen=True)
class Branch:
    value: str
    target: str


@dataclass(frozen=True)
class Choice:
    name: str
    field: str
    branches: tuple[Branch, ...]


@dataclass(frozen=True)
class Range:
    name: str
    field: str
    start: int
    stop: int
    target: str


Node = Terminal | Choice | Range


def nfc(value: str) -> str:
    return unicodedata.normalize("NFC", value)


def canonical_decimal(value: str | Decimal | int) -> str:
    try:
        number = Decimal(str(value))
    except InvalidOperation as error:
        raise SchemaError("invalid decimal") from error
    if not number.is_finite():
        raise SchemaError("non-finite decimals are unsupported")
    if number == 0:
        return "0"
    normalized = number.normalize()
    text = format(normalized, "f")
    if "." in text:
        text = text.rstrip("0").rstrip(".")
    return text


def canonical_date(value: str | date | datetime) -> str:
    if isinstance(value, datetime):
        return value.date().isoformat()
    if isinstance(value, date):
        return value.isoformat()
    try:
        return date.fromisoformat(value).isoformat()
    except ValueError as error:
        raise SchemaError("invalid ISO date") from error


def reject_duplicate_json(text: str) -> Any:
    def pairs(items: list[tuple[str, Any]]) -> dict[str, Any]:
        output: dict[str, Any] = {}
        for key, value in items:
            key = nfc(key)
            if key in output:
                raise SchemaError(f"duplicate JSON key {key!r}")
            output[key] = value
        return output
    try:
        return json.loads(text, object_pairs_hook=pairs)
    except UnicodeDecodeError as error:
        raise SchemaError("invalid UTF-8") from error
    except json.JSONDecodeError as error:
        raise SchemaError("invalid JSON") from error


def canonicalize(value: Any) -> Any:
    if value is None:
        return {"type": "null", "value": None}
    if isinstance(value, bool):
        return {"type": "bool", "value": value}
    if isinstance(value, int):
        return {"type": "int", "value": value}
    if isinstance(value, Decimal):
        return {"type": "decimal", "value": canonical_decimal(value)}
    if isinstance(value, float):
        if not math.isfinite(value):
            raise SchemaError("NaN and infinity are unsupported")
        return {"type": "decimal", "value": canonical_decimal(repr(value))}
    if isinstance(value, str):
        return {"type": "string", "value": nfc(value)}
    if isinstance(value, (date, datetime)):
        return {"type": "date", "value": canonical_date(value)}
    if isinstance(value, list):
        return {"type": "list", "value": [canonicalize(item) for item in value]}
    if isinstance(value, Mapping):
        entries = []
        seen: set[str] = set()
        for key, item in value.items():
            normalized = nfc(str(key))
            if normalized in seen:
                raise SchemaError(f"duplicate canonical key {normalized!r}")
            seen.add(normalized)
            entries.append((normalized, canonicalize(item)))
        entries.sort(key=lambda pair: pair[0])
        return {"type": "map", "value": entries}
    raise SchemaError(f"unsupported canonical type {type(value).__name__}")


def canonical_json(value: Any) -> bytes:
    return json.dumps(canonicalize(value), ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode("utf-8")


class CompiledSchema:
    def __init__(self, document: Mapping[str, Any], *, limits: Limits | None = None):
        self.limits = limits or Limits()
        # Normalize keys/strings and reject unsupported values by round-tripping through a strict canonical form.
        self.document = json.loads(json.dumps(document, ensure_ascii=False))
        self.name = nfc(str(document.get("name", "unnamed")))
        self.version = nfc(str(document.get("version", "0")))
        self.root = str(document.get("root", ""))
        raw_nodes = document.get("nodes")
        if not self.root:
            raise SchemaError("schema root is required")
        if not isinstance(raw_nodes, Mapping) or not raw_nodes:
            raise SchemaError("schema nodes must be non-empty")
        if len(raw_nodes) > self.limits.max_nodes:
            raise SchemaError("node limit exceeded")
        self.nodes = {str(name): self._parse(str(name), raw) for name, raw in raw_nodes.items()}
        if self.root not in self.nodes:
            raise SchemaError("missing root")
        self._counts: dict[str, int] = {}
        self._depths: dict[str, int] = {}
        self._choice_ends: dict[str, tuple[int, ...]] = {}
        self._choice_lookup: dict[str, dict[str, tuple[str, int]]] = {}
        self._postorder: list[str] = []
        self._validate_graph()
        self._validate_path_fields()
        self._compile()

    def _parse(self, name: str, raw: Any) -> Node:
        if not isinstance(raw, Mapping):
            raise SchemaError("node must be mapping")
        kind = raw.get("type")
        if kind == "terminal":
            return Terminal(name)
        if kind == "choice":
            branches_raw = raw.get("branches")
            if not isinstance(branches_raw, list) or not branches_raw:
                raise SchemaError("empty choice")
            branches: list[Branch] = []
            seen: set[str] = set()
            for item in branches_raw:
                if not isinstance(item, Mapping):
                    raise SchemaError("malformed branch")
                value = item.get("value")
                target = item.get("target")
                if not isinstance(value, str) or not target:
                    raise SchemaError("branch requires string value and target")
                value = nfc(value)
                if value in seen:
                    raise SchemaError("duplicate canonical label")
                seen.add(value)
                branches.append(Branch(value, str(target)))
            return Choice(name, nfc(str(raw.get("field", name))), tuple(branches))
        if kind == "range":
            start, stop = raw.get("start"), raw.get("stop")
            if not isinstance(start, int) or isinstance(start, bool):
                raise SchemaError("range start must be integer")
            if not isinstance(stop, int) or isinstance(stop, bool):
                raise SchemaError("range stop must be integer")
            if stop < start:
                raise SchemaError("empty range")
            if stop - start + 1 > self.limits.max_range_width:
                raise SchemaError("range limit exceeded")
            target = raw.get("target")
            if not target:
                raise SchemaError("missing range target")
            return Range(name, nfc(str(raw.get("field", name))), start, stop, str(target))
        raise SchemaError("unsupported node type")

    @staticmethod
    def targets(node: Node) -> tuple[str, ...]:
        if isinstance(node, Terminal):
            return ()
        if isinstance(node, Choice):
            return tuple(branch.target for branch in node.branches)
        return (node.target,)

    def _validate_graph(self) -> None:
        from collections import deque
        for node in self.nodes.values():
            for target in self.targets(node):
                if target not in self.nodes:
                    raise SchemaError("missing target")
      