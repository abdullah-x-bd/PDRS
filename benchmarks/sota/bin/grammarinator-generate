#!/usr/bin/env python3
from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import tempfile


def real_executable() -> str:
    """Find the installed Grammarinator CLI without resolving this wrapper."""
    wrapper_dir = Path(__file__).resolve().parent
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        directory = Path(entry).resolve()
        if directory == wrapper_dir:
            continue
        candidate = directory / "grammarinator-generate"
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    raise RuntimeError("could not locate the installed grammarinator-generate executable")


def main() -> int:
    args = list(sys.argv[1:])
    executable = real_executable()
    if "--stdout" not in args:
        completed = subprocess.run([executable, *args])
        return completed.returncode

    args.remove("--stdout")
    # Near-exhaustive duplicate suppression can require more than the CLI default
    # number of retries. This changes only the retry ceiling, not generation weights.
    if "--unique-attempts" in args:
        index = args.index("--unique-attempts")
        args[index + 1] = str(max(int(args[index + 1]), 100_000))

    with tempfile.TemporaryDirectory(prefix="pdrs-grammarinator-") as directory:
        # Grammarinator 26.1 recognizes the literal `%d` placeholder. Width
        # modifiers such as `%06d` are treated as ordinary text and overwrite.
        pattern = str(Path(directory) / "case_%d.txt")
        completed = subprocess.run(
            [executable, *args, "-o", pattern, "-j", "1"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
        )
        if completed.returncode != 0:
            sys.stderr.write(completed.stderr)
            return completed.returncode
        paths = sorted(
            Path(directory).glob("case_*.txt"),
            key=lambda path: int(path.stem.split("_", 1)[1]),
        )
        if not paths:
            sys.stderr.write(
                "Grammarinator completed successfully but produced no output files.\n"
            )
            return 2
        for path in paths:
            text = path.read_text(encoding="utf-8")
            sys.stdout.write(text)
            if text and not text.endswith("\n"):
                sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
